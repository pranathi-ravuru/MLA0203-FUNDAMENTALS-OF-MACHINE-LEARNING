from sklearn.datasets import load_iris
from sklearn.neighbors import KNeighborsClassifier
from sklearn.metrics import accuracy_score

iris = load_iris()
X = iris.data
y = iris.target

model = KNeighborsClassifier(n_neighbors=3)
model.fit(X, y)

y_pred = model.predict(X)
accuracy = accuracy_score(y, y_pred)

new_flower = [[5.1, 3.5, 1.4, 0.2]]
result = model.predict(new_flower)

print("Sepal Length:", new_flower[0][0])
print("Sepal Width:", new_flower[0][1])
print("Petal Length:", new_flower[0][2])
print("Petal Width:", new_flower[0][3])
print("Predicted Flower:", iris.target_names[result[0]])
print("Accuracy:", round(accuracy * 100, 2), "%")
