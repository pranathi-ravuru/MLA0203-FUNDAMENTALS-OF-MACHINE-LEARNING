from sklearn.datasets import load_iris
from sklearn.linear_model import Perceptron

iris = load_iris()
X = iris.data
y = iris.target

model = Perceptron()
model.fit(X, y)

new_flower = [[5.1, 3.5, 1.4, 0.2]]

result = model.predict(new_flower)

print("Sepal Length:", new_flower[0][0])
print("Sepal Width:", new_flower[0][1])
print("Petal Length:", new_flower[0][2])
print("Petal Width:", new_flower[0][3])
print("Predicted Flower:", iris.target_names[result[0]])

print("Accuracy:", round(model.score(X, y) * 100, 2), "%")
