from sklearn.linear_model import LinearRegression

X = [
    [1000, 2, 5],
    [1200, 2, 4],
    [1500, 3, 3],
    [1800, 3, 2],
    [2000, 4, 2],
    [2200, 4, 1]
]

y = [30, 35, 45, 55, 60, 70]

model = LinearRegression()
model.fit(X, y)

new_house = [[1600, 3, 2]]

result = model.predict(new_house)

accuracy = model.score(X, y)

print("House Area:", new_house[0][0], "sq.ft")
print("Bedrooms:", new_house[0][1])
print("House Age:", new_house[0][2], "years")
print("Predicted House Price:", round(result[0], 2), "Lakhs")
print("Accuracy:", round(accuracy * 100, 2), "%")
